# OpenAI Responses API. Keep the real key in .env.local (already gitignored).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://sub2api.moreuos.com
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=high
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_REQUEST_TIMEOUT_MS=360000

# API port. Vite proxies /api requests here during development.
PORT=5174
DEVFLOW_HOST=0.0.0.0
