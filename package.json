{
  "name": "devflow-task-assignment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "stop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cheerio": "^1.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.0",
    "vite": "^7.0.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
